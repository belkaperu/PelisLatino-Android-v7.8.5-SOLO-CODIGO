<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de película/serie. Estructura: backdrop con veladura → póster solapado
     → CTA → bloques de contenido en cards. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wallpaper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_4">

        <!-- ══════════ BACKDROP + TÍTULO ══════════ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgBackdropDetalle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/backdrop_height"
                android:background="@drawable/bg_pelis_poster_placeholder"
                android:contentDescription="@string/contenido_backdrop"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/backdrop_height"
                android:background="@drawable/bg_scrim_detalle" />

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_scrim_bottom" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3"
                android:paddingBottom="@dimen/poster_detail_overlap">

                <TextView
                    android:id="@+id/txtTipoDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Blabongo.Overline"
                    android:textColor="@color/pelis_text_secondary"
                    tools:text="PELÍCULA · ACCIÓN, CIENCIA FICCIÓN" />

                <TextView
                    android:id="@+id/txtTituloDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:shadowColor="#B3000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textAppearance="@style/TextAppearance.Blabongo.Display"
                    tools:text="Duna: Parte dos" />
            </LinearLayout>
        </FrameLayout>

        <!-- ══════════ PÓSTER SOLAPADO + META ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/poster_detail_overlap_neg"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_3">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/pelis_card"
                app:cardCornerRadius="@dimen/radius_poster"
                app:cardElevation="10dp"
                app:strokeColor="@color/pelis_border"
                app:strokeWidth="@dimen/stroke_hair">

                <ImageView
                    android:id="@+id/imgPosterDetalle"
                    android:layout_width="@dimen/poster_detail_width"
                    android:layout_height="@dimen/poster_detail_height"
                    android:background="@drawable/bg_pelis_poster_placeholder"
                    android:contentDescription="@string/contenido_poster"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtMetaDetalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.Blabongo.Body"
                tools:text="2024 · 2h 06m · 8.2 ★" />
        </LinearLayout>

        <!-- ══════════ ACCIÓN PRINCIPAL ══════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReproducirDetalle"
            style="@style/Widget.Blabongo.Button.Play"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_3"
            android:layout_marginTop="@dimen/space_3"
            android:layout_marginEnd="@dimen/space_3"
            android:text="@string/pelis_reproducir" />

        <TextView
            android:id="@+id/txtEstadoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginEnd="@dimen/space_3"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Blabongo.Caption"
            tools:text="Resolviendo stream del servidor…" />

        <!-- ══════════ SINOPSIS ══════════ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Blabongo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_marginTop="@dimen/space_3"
            android:layout_marginEnd="@dimen/space_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View style="@style/Widget.Blabongo.SectionBar" />

                    <TextView
                        style="@style/Widget.Blabongo.SectionTitle"
                        android:layout_marginStart="@dimen/space_1_5"
                        android:text="@string/pelis_sinopsis" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSinopsisDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1_5"
                    android:justificationMode="inter_word"
                    android:textAppearance="@style/TextAppearance.Blabongo.Body"
                    android:textColor="@color/pelis_text_secondary"
                    tools:text="Paul Atreides se une a los Fremen para vengar a su casa y evitar un futuro terrible." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════ EPISODIOS (series) ══════════ -->
        <LinearLayout
            android:id="@+id/contenedorEpisodios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Blabongo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginEnd="@dimen/space_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_1_5"
                    android:paddingBottom="@dimen/space_1_5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_3"
                        android:paddingEnd="@dimen/space_3">

                        <View style="@style/Widget.Blabongo.SectionBar" />

                        <TextView
                            style="@style/Widget.Blabongo.SectionTitle"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/space_1_5"
                            android:layout_weight="1"
                            android:text="@string/pelis_temporada" />

                        <Spinner
                            android:id="@+id/spinnerTemporadas"
                            style="@style/Widget.Blabongo.Spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:minWidth="86dp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerEpisodios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_pelis_episodio" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_2"
            android:indeterminateTint="@color/pelis_accent"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
