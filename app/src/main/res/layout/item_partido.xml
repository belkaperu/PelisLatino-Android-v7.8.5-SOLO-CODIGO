<?xml version="1.0" encoding="utf-8"?>
<!-- Partido: barra de acento a la izquierda, hora en pastilla y canales expandibles. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Blabongo.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_2"
    android:layout_marginTop="@dimen/space_1"
    android:layout_marginEnd="@dimen/space_2"
    android:layout_marginBottom="@dimen/space_1"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/stroke_accent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_section_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_2"
            android:paddingBottom="@dimen/space_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textHora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_partido_hora"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/pelis_text"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    tools:text="12:00 PM" />

                <TextView
                    android:id="@+id/textDescripcion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:textColor="@color/pelis_text"
                    android:textSize="@dimen/text_body"
                    tools:text="Real Madrid vs Barcelona" />
            </LinearLayout>

            <!-- Canales del partido (los añade PartidoAdapter al expandir) -->
            <LinearLayout
                android:id="@+id/channelsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1_5"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
