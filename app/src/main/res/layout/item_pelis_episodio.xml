<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de episodio: número, título, fecha y acción a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Blabongo.Row"
    android:paddingTop="@dimen/space_1_5"
    android:paddingBottom="@dimen/space_1_5">

    <TextView
        android:id="@+id/txtEpisodioNumero"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Blabongo.Badge"
        android:textColor="@color/pelis_accent"
        android:textSize="@dimen/text_caption"
        tools:text="E04" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtEpisodioTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/pelis_text"
            android:textSize="@dimen/text_body"
            tools:text="Título del episodio" />

        <TextView
            android:id="@+id/txtEpisodioFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textAppearance="@style/TextAppearance.Blabongo.Caption"
            android:textSize="@dimen/text_micro"
            tools:text="12 de mayo, 2024" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_1"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/pelis_reproducir"
        android:padding="13dp"
        android:src="@drawable/ic_play"
        app:tint="@color/pelis_accent" />

</LinearLayout>
