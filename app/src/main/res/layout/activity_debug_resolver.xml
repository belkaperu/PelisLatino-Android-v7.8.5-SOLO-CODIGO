<?xml version="1.0" encoding="utf-8"?>
<!-- Herramienta interna: puesta en la misma piel oscura que el resto de la app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pelis_bg"
    android:orientation="vertical"
    android:padding="@dimen/space_3">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_3"
        android:text="@string/debug_titulo"
        android:textAppearance="@style/TextAppearance.Blabongo.Title" />

    <Button
        android:id="@+id/btnPeliEjemplo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/debug_ejemplo" />

    <Button
        android:id="@+id/btnPeliId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1_5"
        android:text="@string/debug_id" />

    <Button
        android:id="@+id/btnVerLogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1_5"
        android:text="@string/debug_logs" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_3"
        android:layout_weight="1"
        android:background="@drawable/bg_row_feedback"
        android:padding="@dimen/space_2">

        <TextView
            android:id="@+id/txtResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/debug_resultados"
            android:textAppearance="@style/TextAppearance.Blabongo.Body"
            android:textSize="@dimen/text_caption"
            tools:text="OK" />
    </ScrollView>

</LinearLayout>
