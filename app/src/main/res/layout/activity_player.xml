<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- 1. REPRODUCTOR / CONTENEDOR DE VIDEO -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        tools:ignore="MissingClass">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            app:resize_mode="fill"
            app:show_buffering="when_playing"
            app:use_controller="false" />

        <WebView
            android:id="@+id/webPlayable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:visibility="gone" />

        <!-- INDICADOR DE CARGA -->
        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- CONTROLES CENTRALES DE REPRODUCCIÓN -->
        <LinearLayout
            android:id="@+id/centerControlsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_rewind"
                android:src="@drawable/ic_rewind" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_play_pause"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_forward"
                android:src="@drawable/ic_forward" />

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_volume"
                android:src="@drawable/ic_volume" />

            <ImageButton
                android:id="@+id/btnPip"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Picture-in-Picture"
                android:src="@drawable/ic_pip" />

            <ImageButton
                android:id="@+id/btnFullscreen"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_pantalla"
                android:src="@drawable/ic_pantalla_completa" />

            <ImageButton
                android:id="@+id/btnCerrar"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_close"
                android:src="@drawable/ic_cerrar"
                app:tint="@color/pelis_live" />
        </LinearLayout>

        <TextView
            android:id="@+id/chipCalidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@color/pelis_scrim_strong"
            android:textColor="@color/pelis_text"
            android:textSize="13sp"
            android:visibility="gone"
            android:text="HD ▾" />
    </FrameLayout>

    <!-- 2. LISTA DE SERVIDORES - EN LA PARTE SUPERIOR DEL REPRODUCTOR -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/videoContainer"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/serversContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_refresh"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. LISTA DE CANALES - EN LA PARTE INFERIOR DEL REPRODUCTOR -->
    <LinearLayout
        android:id="@+id/channelsLayout"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:layout_alignBottom="@id/videoContainer"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <HorizontalScrollView
            android:id="@+id/scrollCanalesPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/channelsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>
    </LinearLayout>

</RelativeLayout>
