<?xml version="1.0" encoding="utf-8"?>
<!-- Celda de la rejilla del panel (v3.2.53, captura del Drama real): cuadro redondeado
     con la bandera o el glifo de la categoria arriba y el nombre abajo. El fondo es
     bg_canal_tab: la celda activa recibe el bloque azul igual que los tabs de la tira. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_canal_tab"
    android:gravity="center"
    android:minHeight="84dp"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="6dp"
    android:paddingEnd="2dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/txtCeldaBandera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_panel_celda_icon"
        android:gravity="center"
        android:textSize="28sp"
        tools:text="🇵" />

    <ImageView
        android:id="@+id/imgCelda"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_panel_celda_icon"
        android:contentDescription="@null"
        android:padding="11dp"
        android:src="@drawable/ic_topic_grid"
        app:tint="@color/pelis_text_secondary"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/txtCeldaNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/pelis_text"
        android:textSize="12sp"
        tools:text="Favoritos" />
</LinearLayout>
