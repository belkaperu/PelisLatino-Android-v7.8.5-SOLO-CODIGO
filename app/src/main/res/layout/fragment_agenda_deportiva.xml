<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".AgendaDeportivaFragment">

    <!-- Cabecera con la fecha del día (antes texto blanco centrado sin fondo) -->
    <LinearLayout
        android:id="@+id/cabeceraAgenda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_cine"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_2"
        app:layout_constraintTop_toTopOf="parent">

        <View style="@style/Widget.Blabongo.SectionBar" />

        <TextView
            android:id="@+id/txtTituloAgenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1_5"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/agenda_cargando"
            android:textAppearance="@style/TextAppearance.Blabongo.Title" />

        <ImageView
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:alpha="0.85"
            android:contentDescription="@string/agenda_titulo"
            android:padding="@dimen/space_1_5"
            android:src="@drawable/ic_sports"
            app:tint="@color/pelis_accent" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_1_5"
        android:paddingBottom="@dimen/space_4"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cabeceraAgenda"
        tools:listitem="@layout/item_partido" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/pelis_accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
