<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_intro_gradient"
    tools:context=".AppIntroActivity">

    <!-- ViewPager2 para los slides -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@id/tvDotContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Contenedor de los dots -->
    <LinearLayout
        android:id="@+id/tvDotContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dot_ring"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_1"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewPager"
        app:layout_constraintVertical_bias="0.3">

        <ImageView
            android:id="@+id/ivDotPrevious"
            android:layout_width="@dimen/intro_dots"
            android:layout_height="@dimen/intro_dots"
            android:contentDescription="@null"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/ivDotCurrent"
            android:layout_width="@dimen/intro_dots"
            android:layout_height="@dimen/intro_dots"
            android:layout_marginStart="@dimen/space_1_5"
            android:layout_marginEnd="@dimen/space_1_5"
            android:contentDescription="@null"
            android:src="@drawable/dot_active" />

        <ImageView
            android:id="@+id/ivDotNext"
            android:layout_width="@dimen/intro_dots"
            android:layout_height="@dimen/intro_dots"
            android:contentDescription="@null"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- Contenedor de botones -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkip"
            style="@style/Widget.Blabongo.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_skip" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/Widget.Blabongo.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_next" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinish"
            style="@style/Widget.Blabongo.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_finish" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
