<?xml version="1.0" encoding="utf-8"?>
<!-- Fuente de canales. DramaLive hace lo mismo en su "CHANGE THE SOURCE": una
   sola hoja con los campos de la lista. Aquí se aceptan las dos formas que el
   ecosistema usa: código FG (resuelto por un endpoint) o URL M3U/JSON directa. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_top_rounded"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_4">

        <View
            android:layout_width="@dimen/sheet_handle_width"
            android:layout_height="@dimen/sheet_handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_3"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fuente_titulo"
            android:textAppearance="@style/TextAppearance.Blabongo.Title" />

        <!-- ══ automático ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_titulo"
                    android:textAppearance="@style/TextAppearance.Blabongo.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/auto_sub"
                    android:textAppearance="@style/TextAppearance.Blabongo.Caption" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cambioAutoCanales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:contentDescription="@string/auto_activar"
                android:minWidth="@dimen/touch_min"
                android:minHeight="@dimen/touch_min" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/logos_titulo"
                    android:textAppearance="@style/TextAppearance.Blabongo.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/logos_sub"
                    android:textAppearance="@style/TextAppearance.Blabongo.Caption" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cambioLogosReducidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:contentDescription="@string/logos_titulo"
                android:minWidth="@dimen/touch_min"
                android:minHeight="@dimen/touch_min" />
        </LinearLayout>

        <TextView
            style="@style/Widget.Blabongo.FieldLabel"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/auto_alcance_titulo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_alcance_sub"
            android:textAppearance="@style/TextAppearance.Blabongo.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAlcanceCorto"
                style="@style/Widget.Blabongo.Chip"
                android:text="@string/auto_alcance_corto" />

            <TextView
                android:id="@+id/chipAlcanceLatam"
                style="@style/Widget.Blabongo.Chip"
                android:layout_marginStart="@dimen/space_1"
                android:text="@string/auto_alcance_latam" />

            <TextView
                android:id="@+id/chipAlcanceGlobal"
                style="@style/Widget.Blabongo.Chip"
                android:layout_marginStart="@dimen/space_1"
                android:text="@string/auto_alcance_global" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtAutoEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.Blabongo.Caption"
            android:textColor="@color/pelis_accent"
            tools:text="Fuente usada: Deportes · iptv-org (caché hace 12 min)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoForzar"
                style="@style/Widget.Blabongo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/auto_forzar"
                android:textSize="@dimen/text_caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoVaciar"
                style="@style/Widget.Blabongo.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/space_1"
                android:text="@string/auto_vaciar"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_3"
            android:background="@color/pelis_border" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/fuente_intro"
            android:textAppearance="@style/TextAppearance.Blabongo.Body" />

        <TextView
            style="@style/Widget.Blabongo.FieldLabel"
            android:text="@string/fuente_codigo_label" />

        <EditText
            android:id="@+id/editCodigoFuente"
            style="@style/Widget.Blabongo.Field"
            android:hint="@string/fuente_codigo_hint"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword"
            android:maxLines="1" />

        <TextView
            style="@style/Widget.Blabongo.FieldLabel"
            android:text="@string/fuente_m3u_label" />

        <EditText
            android:id="@+id/editUrlFuente"
            style="@style/Widget.Blabongo.Field"
            android:hint="@string/fuente_m3u_hint"
            android:importantForAutofill="no"
            android:maxLines="3" />

        <!-- ══ pegar la lista o una URL suelta: lo que el navegador ya tiene delante ══ -->
        <TextView
            style="@style/Widget.Blabongo.FieldLabel"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/pegada_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pegada_sub"
            android:textAppearance="@style/TextAppearance.Blabongo.Caption" />

        <EditText
            android:id="@+id/editListaPegada"
            style="@style/Widget.Blabongo.Field"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="top"
            android:hint="@string/pegada_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="8"
            android:minLines="3"
            android:scrollbars="vertical"
            tools:text="#EXTM3U" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUsarPegada"
                style="@style/Widget.Blabongo.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/pegada_usar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuitarPegada"
                style="@style/Widget.Blabongo.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/space_1"
                android:text="@string/pegada_quitar" />
        </LinearLayout>

        <TextView
            style="@style/Widget.Blabongo.FieldLabel"
            android:text="@string/fuente_endpoint_label" />

        <EditText
            android:id="@+id/editEndpointFuente"
            style="@style/Widget.Blabongo.Field"
            android:importantForAutofill="no"
            android:maxLines="3"
            tools:text="https://fgcode.store/link/api.php/get?code=" />

        <!-- ══ panel Xtream: lo que DramaLive usa por dentro (player_api.php) ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xtream_titulo"
                    android:textAppearance="@style/TextAppearance.Blabongo.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/xtream_sub"
                    android:textAppearance="@style/TextAppearance.Blabongo.Caption" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cambioXtreamActivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/xtream_titulo" />
        </LinearLayout>

        <TextView
            style="@style/Widget.Blabongo.FieldLabel"
            android:text="@string/xtream_host_label" />

        <EditText
            android:id="@+id/editXtreamHost"
            style="@style/Widget.Blabongo.Field"
            android:hint="@string/xtream_host_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            tools:text="http://mi-panel.net:8080" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editXtreamUsuario"
                style="@style/Widget.Blabongo.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_1"
                android:layout_weight="1"
                android:hint="@string/xtream_usuario_hint"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLines="1" />

            <EditText
                android:id="@+id/editXtreamClave"
                style="@style/Widget.Blabongo.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/xtream_clave_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnXtreamGuardar"
            style="@style/Widget.Blabongo.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/xtream_probar" />

        <TextView
            android:id="@+id/txtEstadoFuente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Blabongo.Caption"
            android:textColor="@color/pelis_accent"
            tools:text="El servidor respondió 500" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProbarFuente"
            style="@style/Widget.Blabongo.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/fuente_probar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarFuente"
            style="@style/Widget.Blabongo.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/fuente_guardar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFuentePorDefecto"
            style="@style/Widget.Blabongo.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="@string/fuente_por_defecto" />
    </LinearLayout>
</ScrollView>
