<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de canales de un partido (la usa PartidoAdapter). Ripple + resaltado al pulsar. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/pelis_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/pelis_surface" />
            <stroke android:width="1dp" android:color="@color/pelis_border_soft" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
