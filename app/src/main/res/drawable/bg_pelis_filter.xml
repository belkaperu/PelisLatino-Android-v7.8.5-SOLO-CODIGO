<?xml version="1.0" encoding="utf-8"?>
<!-- Chips de filtro. El estado "selected" lo pone PelisFragment con setSelected(),
     así el fondo y el texto cambian juntos y con ripple, sin tocar recursos. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:drawable="@drawable/bg_pelis_chip_selected" />
    <item android:state_activated="true" android:drawable="@drawable/bg_pelis_chip_selected" />
    <item android:state_pressed="true" android:drawable="@drawable/bg_pelis_chip_pressed" />
    <item android:drawable="@drawable/bg_pelis_chip_idle" />
</selector>
