<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera del drawer. Antes: degradado violeta→negro con halo azul. El sitio
     no tiene violeta en ninguna parte; su cabecera es teal con un halo del azul
     de acento. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/pelis_primary_deep"
                android:centerColor="@color/pelis_surface"
                android:endColor="@color/pelis_bg_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:centerX="8%"
                android:centerY="18%"
                android:startColor="#4D2196F3"
                android:endColor="#002196F3" />
        </shape>
    </item>
</layer-list>
