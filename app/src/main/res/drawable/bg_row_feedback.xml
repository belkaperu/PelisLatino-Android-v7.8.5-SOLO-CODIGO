<?xml version="1.0" encoding="utf-8"?>
<!-- Mensaje de vacío/error, que además se puede tocar para reintentar. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/pelis_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_field" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/pelis_surface" />
            <stroke android:width="1dp" android:color="@color/pelis_border" />
            <corners android:radius="@dimen/radius_field" />
        </shape>
    </item>
</ripple>
