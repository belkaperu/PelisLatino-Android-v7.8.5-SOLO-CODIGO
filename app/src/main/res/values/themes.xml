<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ════════════════════════════════════════════════════════════════════
         Tema global BLABONGO — oscuro "cine", sin ActionBar.

         La app es dark-first: se usan los dos valores (day y night) con la
         misma paleta para que ningún widget del sistema (diálogos, spinner,
         cursor, bottom sheet) se pinte claro a mitad de pantalla.

         Todo lo reutilizable vive en:
           values/colors.xml  → paleta
           values/dimens.xml  → espaciado, radios, tamaños de texto
           values/styles.xml  → TextAppearance.* y Widget.Blabongo.*
         Un layout NO debería volver a poner un #RRGGBB suelto.
         ════════════════════════════════════════════════════════════════════ -->

    <!-- El tema es deliberadamente oscuro en values/ y NO tiene variante en
         values-night/: la app se diseñó en negro cinematográfico y una versión
         "light" a medio hacer es lo que producía los parches blancos (campo de
         búsqueda de canales, bottom sheet de canales, cabecera del drawer). -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.NoActionBar">

        <!-- Color del sistema Material -->
        <item name="colorPrimary">@color/pelis_primary</item>
        <item name="colorPrimaryVariant">@color/pelis_primary_dark</item>
        <item name="colorOnPrimary">@color/pelis_text</item>
        <item name="colorSecondary">@color/pelis_red</item>
        <item name="colorSecondaryVariant">@color/pelis_red_dark</item>
        <item name="colorOnSecondary">@color/pelis_text</item>
        <item name="colorAccent">@color/pelis_accent</item>
        <item name="colorSurface">@color/pelis_surface</item>
        <item name="colorOnSurface">@color/pelis_text</item>
        <item name="colorOnBackground">@color/pelis_text</item>
        <item name="colorError">@color/pelis_live</item>
        <item name="android:colorBackground">@color/pelis_bg</item>

        <!-- Controles -->
        <item name="colorControlNormal">@color/pelis_muted</item>
        <item name="colorControlActivated">@color/pelis_accent</item>
        <item name="colorControlHighlight">@color/pelis_ripple</item>

        <!-- Texto del sistema (spinners, hints, EditText sueltos, menus) -->
        <item name="android:textColorPrimary">@color/pelis_text</item>
        <item name="android:textColorSecondary">@color/pelis_text_secondary</item>
        <item name="android:textColorTertiary">@color/pelis_muted</item>
        <item name="android:textColorHint">@color/pelis_muted</item>
        <item name="android:textColorLink">@color/pelis_accent</item>

        <!-- Ventana -->
        <item name="android:windowBackground">@drawable/bg_window_cinematic</item>
        <item name="android:statusBarColor">@color/pelis_bg_dark</item>
        <item name="android:navigationBarColor">@color/pelis_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>

        <!-- Tipografía: DramaLive usa una sola familia (Poppins). android:fontFamily NO
             se hereda a los TextView desde el tema (hay que pasarla por android:textViewStyle
             / android:editTextStyle), y ponerla aquí además la heredan cosas que no son
             TextViews de la app (WebView del player, vistas del banner, RemoteViews de
             notificación) apuntando a un id de recurso privado. Por eso SOLO se fijan los
             estilos de widget. -->
        <item name="android:textViewStyle">@style/Widget.Blabongo.TextView</item>
        <item name="android:editTextStyle">@style/Widget.Blabongo.EditText</item>

        <!-- Widgets por defecto -->
        <item name="materialButtonStyle">@style/Widget.Blabongo.Button</item>
        <item name="toolbarStyle">@style/Widget.Blabongo.Toolbar</item>
        <item name="cardViewStyle">@style/Widget.Blabongo.Card</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.PelisLatino.BottomSheet</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.PelisLatino.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PelisLatino.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/Theme.PelisLatino.FrameworkDialog</item>
        <item name="android:popupMenuStyle">@style/Widget.Blabongo.PopupMenu</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Blabongo.Section</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Blabongo.Caption</item>
    </style>

    <!-- ══════════════ Diálogos ══════════════ -->

    <style name="ThemeOverlay.PelisLatino.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/pelis_accent</item>
        <item name="colorSurface">@color/pelis_card</item>
        <item name="colorOnSurface">@color/pelis_text</item>
        <item name="android:textColorSecondary">@color/pelis_text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Blabongo.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Blabongo.DialogBody</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Blabongo.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Blabongo.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Blabongo.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Blabongo.DialogButton</item>
    </style>

    <style name="Theme.PelisLatino.FrameworkDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/pelis_accent</item>
        <item name="colorAccent">@color/pelis_accent</item>
        <item name="colorSurface">@color/pelis_card</item>
        <item name="android:colorBackground">@color/pelis_card</item>
        <item name="android:textColorPrimary">@color/pelis_text</item>
        <item name="android:textColorSecondary">@color/pelis_text_secondary</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>



    <style name="ShapeAppearance.Blabongo.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>


    <style name="Widget.Blabongo.PopupMenu" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@color/pelis_card_high</item>
    </style>

    <!-- ══════════════ Bottom sheet ══════════════ -->

    <style name="ThemeOverlay.PelisLatino.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="colorSurface">@color/pelis_surface</item>
        <item name="android:colorBackground">@color/pelis_surface</item>
        <item name="android:navigationBarColor">@color/pelis_surface</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@color/pelis_bg_dark</item>
        <item name="bottomSheetStyle">@style/Widget.Blabongo.BottomSheet</item>
    </style>

    <style name="Widget.Blabongo.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Blabongo.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Blabongo.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.PelisLatino.Popup" parent="ThemeOverlay.MaterialComponents">
        <item name="android:colorBackground">@color/pelis_card_high</item>
        <item name="colorSurface">@color/pelis_card_high</item>
        <item name="android:textColorPrimary">@color/pelis_text</item>
        <item name="android:textColor">@color/pelis_text</item>
    </style>

    <!-- ══════════════ Toolbar ══════════════ -->

    <!-- Los iconos de la barra (buscar, refrescar, fuente) tienen que salir
         blancos, como el texto. El colorControlNormal del tema es pelis_muted
         (gris) y por eso el de refrescar se veia casi negro sobre el teal: era
         el unico que no heredaba el overlay oscuro. Este overlay lo arregla solo
         en la barra, sin tocar el resto de la app. -->
    <style name="ThemeOverlay.Blabongo.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorControlNormal">@color/pelis_text</item>
        <item name="actionMenuTextColor">@color/pelis_text</item>
    </style>

    <style name="Widget.Blabongo.Toolbar" parent="Widget.MaterialComponents.Toolbar">        <item name="android:background">@drawable/bg_toolbar_cine</item>
        <item name="android:elevation">6dp</item>
        <item name="titleTextColor">@color/pelis_text</item>
        <item name="subtitleTextColor">@color/pelis_muted</item>
        <item name="titleTextAppearance">@style/TextAppearance.Blabongo.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.Blabongo.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/pelis_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
