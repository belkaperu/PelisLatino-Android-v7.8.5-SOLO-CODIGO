    <!-- ══ Radios ══
         Medidos sobre web.dramalive.cc: el tile de canal tiene ~15 dp de radio
         (arco de 90 px en la captura a 3x = 6x tras ampliar), la tarjeta de
         categoría ~14 dp y el campo de búsqueda es una PASTILLA completa
         (radio = mitad de la altura, 26 px sobre 52 px de alto). Antes de esta
         pasada el campo iba a 10 dp y el tile a 14 dp: el tile ya estaba bien. -->
    <dimen name="radius_badge">4dp</dimen>
    <dimen name="radius_field">12dp</dimen>
    <dimen name="radius_pill">25dp</dimen>
    <dimen name="radius_button">10dp</dimen>
    <dimen name="radius_card">12dp</dimen>
    <dimen name="radius_poster">12dp</dimen>
    <dimen name="radius_tile">15dp</dimen>
    <dimen name="radius_sheet">16dp</dimen>
    <dimen name="radius_chip">12dp</dimen>

    <!-- ══ Tipografía (Poppins, ver res/font/poppins.xml) ══ -->
    <dimen name="text_display">22sp</dimen>
    <dimen name="text_title">18sp</dimen>
    <dimen name="text_subtitle">15sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_micro">11sp</dimen>
    <dimen name="text_badge">11sp</dimen>

    <!-- ══ Controles ══ -->
