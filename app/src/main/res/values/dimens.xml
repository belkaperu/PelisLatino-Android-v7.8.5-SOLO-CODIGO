    <dimen name="chip_min_width">68dp</dimen>
    <dimen name="field_height">46dp</dimen>
    <!-- La barra del sitio mide 56 px de alto con una pastilla de búsqueda de 36;
         proporcionalmente, 56 dp de barra y 44 dp de pastilla. -->
    <dimen name="appbar_height">56dp</dimen>
    <dimen name="search_height">44dp</dimen>
    <dimen name="button_height">48dp</dimen>
    <dimen name="touch_min">44dp</dimen>
    <dimen name="icon_sm">18dp</dimen>
    <dimen name="icon_md">20dp</dimen>
    <dimen name="icon_lg">24dp</dimen>
    <dimen name="stroke_hair">1dp</dimen>
    <dimen name="stroke_ring">1dp</dimen>
    <dimen name="stroke_accent">3dp</dimen>

    <!-- ══ Catálogo de pelis ══ -->
    <dimen name="poster_height">216dp</dimen>
    <dimen name="card_margin">5dp</dimen>
    <dimen name="grid_gutter">8dp</dimen>
    <dimen name="card_elevation">3dp</dimen>
    <dimen name="card_elevation_flat">0dp</dimen>

    <!-- ══ Canales ══
         Valores de las capturas del Drama Live real (cat-sports, cur-00,
         nav-rt, m-00): la rejilla es de 3 columnas de tiles CUADRADOS con el
         nombre DENTRO, en una banda inferior. Es lo mismo que hace la web.

         Ojo: en el APK que se analizó existe `item_live_list` (una fila con
         logo de 100 dp + nombre al lado) y por eso la v9.2 pasó los canales a
         filas. Fue un error: esa pantalla no es la que la app pinta. Las
         capturas del cliente real lo desmienten. -->
    <dimen name="canal_grid_pad">16dp</dimen>
    <!-- El margen lo pone CADA tile, o sea que el hueco entre dos vecinos es el
         doble: 4.5 dp para que salgan los 9 dp medidos en la web. -->
    <dimen name="canal_tile_gutter">4.5dp</dimen>
    <dimen name="canal_logo_pad">12dp</dimen>
    <dimen name="canal_name_h">22dp</dimen>

    <!-- Tira de categorías: cuadro de icono de ~56 dp con el rótulo DEBAJO,
         fuera del cuadro (nav-rt: el bloque azul de "Most watched" mide
         ~67x55 dp y el rótulo queda por debajo, sobre el fondo). -->
    <dimen name="canal_tab_h">78dp</dimen>
    <dimen name="canal_tab_icon">52dp</dimen>
    <dimen name="canal_tab_gap">6dp</dimen>

    <!-- ══ Detalle ══ -->
